<?xml version="1.0" encoding="utf-8"?>
<!-- Tela de boot do sistema, exibida entre o toque no icone e o primeiro
     frame do Flutter. Fundo na cor da marca com a marca centralizada, para
     nao haver o flash branco padrao. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_green" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
